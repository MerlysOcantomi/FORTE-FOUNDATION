{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MerlysOcantomi/FORTE-FOUNDATION/spec/schemas/catalog.schema.json",
  "title": "Forte Foundation catalog (registry/catalog.yaml)",
  "description": "Catálogo de bloques conocidos por Foundation, incluidos los que todavía son candidatos. Ver spec/catalog.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "families", "blocks"],
  "properties": {
    "catalog_version": { "type": "integer", "const": 1 },
    "updated_at": { "type": "string", "format": "date" },
    "families": {
      "description": "Definición de cada familia permitida. Debe coincidir con el enum de block.schema.json.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core", "capabilities", "providers", "patterns", "operational-safety",
        "persistence", "platform", "regions", "templates", "testing"
      ],
      "properties": {
        "core": { "$ref": "#/$defs/familyDef" },
        "capabilities": { "$ref": "#/$defs/familyDef" },
        "providers": { "$ref": "#/$defs/familyDef" },
        "patterns": { "$ref": "#/$defs/familyDef" },
        "operational-safety": { "$ref": "#/$defs/familyDef" },
        "persistence": { "$ref": "#/$defs/familyDef" },
        "platform": { "$ref": "#/$defs/familyDef" },
        "regions": { "$ref": "#/$defs/familyDef" },
        "templates": { "$ref": "#/$defs/familyDef" },
        "testing": { "$ref": "#/$defs/familyDef" }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/catalogEntry" }
    }
  },
  "$defs": {
    "familyDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "blockId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "catalogEntry": {
      "description": "Entrada del catálogo. Es un subconjunto de block.yaml: lo necesario para que Mission Control descubra y seleccione. Un bloque candidate no tiene versión ni carpeta en blocks/.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "family", "status", "variant", "description", "default_for", "origin"],
      "properties": {
        "id": { "$ref": "#/$defs/blockId" },
        "name": { "type": "string", "minLength": 1 },
        "family": {
          "type": "string",
          "enum": [
            "core", "capabilities", "providers", "patterns", "operational-safety",
            "persistence", "platform", "regions", "templates", "testing"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["candidate", "draft", "stable", "deprecated"]
        },
        "variant": {
          "type": "string",
          "pattern": "^(core|vertical:[a-z][a-z0-9-]*|region:[a-z]{2}(-[a-z0-9]+)*|region:global|region:eu)$"
        },
        "extends": { "$ref": "#/$defs/blockId" },
        "description": { "type": "string", "minLength": 1 },
        "latest_version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
          "description": "Solo presente cuando status es draft, stable o deprecated."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Carpeta del bloque dentro de blocks/. Solo presente cuando existe implementación."
        },
        "requires": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/blockId" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(\\^|~|>=|>|<=|<|=)?(0|[1-9]\\d*)(\\.(0|[1-9]\\d*|x|\\*))?(\\.(0|[1-9]\\d*|x|\\*))?( +(\\^|~|>=|>|<=|<|=)?(0|[1-9]\\d*)(\\.(0|[1-9]\\d*|x|\\*))?(\\.(0|[1-9]\\d*|x|\\*))?)*$"
          }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "decision_mode": {
          "type": "string",
          "enum": ["deterministic", "ai", "mixed"]
        },
        "default_for": {
          "type": "string",
          "enum": ["all-products", "on-demand"]
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product"],
          "properties": {
            "product": { "type": "string", "minLength": 1 },
            "date": { "type": "string", "format": "date" },
            "notes": { "type": "string" }
          }
        },
        "handoff_sections": {
          "description": "Secciones del handoff (docs/00-handoff.md) donde se identificó el bloque. Trazabilidad, no autoridad.",
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 47 }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "candidate" } } },
          "then": {
            "not": { "anyOf": [ { "required": ["latest_version"] }, { "required": ["path"] } ] }
          },
          "else": { "required": ["latest_version", "path"] }
        }
      ]
    }
  }
}
